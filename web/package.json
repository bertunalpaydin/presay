{
  "name": "presay",
  "version": "1.0.0",
  "private": true,
  "description": "Presay: check a script for words that may be misheard, and practise them, entirely in the browser.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/serve.mjs",
    "vendor": "node scripts/vendor.mjs",
    "build:data": "node scripts/build-data.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "images": "node scripts/make-images.mjs"
  },
  "devDependencies": {
    "@fontsource/gentium-book-plus": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@huggingface/transformers": "4.3.2",
    "cmu-pronouncing-dictionary": "3.0.0",
    "puppeteer-core": "25.18.1",
    "wordlist-english": "1.2.1",
    "wordnet-db": "3.1.14"
  }
}
